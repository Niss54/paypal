# --- Database & Infrastructure ---
POSTGRES_USER=kinetix_admin
POSTGRES_PASSWORD=your_secure_postgres_password_here
POSTGRES_DB=kinetix_enterprise
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=kinetix-local-password
NEO4J_DATABASE=neo4j

# --- Phase 2: required now ---
# Gemini powers structured entity extraction, P&ID vision, and the optional
# compatibility OCR fallback.
GEMINI_API_KEY=
GEMINI_REASONING_MODEL=gemini-3.1-flash-lite
GEMINI_INGESTION_MODEL=gemini-3.1-flash-lite
CLOUD_OCR_PROVIDER=google_vision
GOOGLE_VISION_API_KEY=
GOOGLE_VISION_TIMEOUT_SECONDS=60
# Redis backs the continuous-ingestion RQ queue (watcher step).
REDIS_URL=redis://localhost:6379
# Folder the watchdog file-watcher monitors for new documents.
INGEST_WATCH_DIR=data/incoming
# Local development stores immutable queued objects here. For separate
# deployed services, set INGEST_STORAGE_BACKEND=s3 and configure the S3-compatible fields below.
INGEST_STORAGE_BACKEND=local
INGEST_OBJECT_DIR=.runtime/ingest-objects
INGEST_WORK_DIR=.runtime/ingest-work
INGEST_MAX_UPLOAD_BYTES=52428800
INGEST_S3_BUCKET=
INGEST_S3_PREFIX=kinetix-ingest
INGEST_S3_ENDPOINT=
INGEST_S3_REGION=
INGEST_S3_ACCESS_KEY_ID=
INGEST_S3_SECRET_ACCESS_KEY=
# Optional — only set if the `tesseract` binary isn't on PATH (common on Windows).
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe

# --- Retrieval, agents, evaluation, and memory ---
GROQ_API_KEY=
GROQ_REASONING_MODEL=llama-3.3-70b-versatile
GROQ_ROUTING_MODEL=llama-3.1-8b-instant
GROQ_JUDGE_MODEL=llama-3.3-70b-versatile
RAGAS_OSS_JUDGE_MAX_TOKENS=4096
RAGAS_JUDGE_TIMEOUT_SECONDS=45
RAGAS_JUDGE_MAX_RETRIES=2
RAGAS_METRIC_MAX_RETRIES=3
RAGAS_METRIC_RETRY_DELAY_SECONDS=45
RAGAS_METRIC_PACING_SECONDS=45
RAGAS_RELEVANCY_STRICTNESS=1
RAGAS_CASE_MAX_RETRIES=2
RAGAS_CASE_RETRY_DELAY_SECONDS=2
RAGAS_CASE_MAX_RETRY_DELAY_SECONDS=900
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
RERANK_PROVIDER=local
COHERE_API_KEY=
COHERE_RERANK_MODEL=rerank-v4.0-pro
MEM0_API_KEY=
# Writable local location used by the mem0 client for telemetry/config metadata.
MEM0_DIR=.runtime/mem0

# --- Backend and proactive worker ---
BACKEND_CORS_ORIGINS=http://localhost:3000,http://localhost:3001
TELEMETRY_INTERVAL_SECONDS=15
TELEMETRY_EQUIPMENT_TAGS=P-101,C-201,HX-401,PSV-701,T-501,P-102

# =====================================================================
# PAYPAL AI HACKATHON 2026: AGENTIC COMMERCE & MACHINE MONEY (PAYPAL + MULTI-RAIL SETTLEMENT)
# =====================================================================
DEMO_STANDALONE=true
MACHINE_MONEY_ENABLED=true
MACHINE_MONEY_PROVIDER=mock
MACHINE_MONEY_NETWORK=regtest
MACHINE_MONEY_AUTO_PAY_ENABLED=true
MACHINE_MONEY_MAX_AUTOPAY_SATS=500
MACHINE_MONEY_AUTO_PAY_THRESHOLD_SATS=500
MACHINE_MONEY_PROVIDER_ALLOWLIST=provider_pump_specialist,provider_bearing_inspections

# Optional: Live LNbits Signet configuration (if evaluated against live node)
LNBITS_BASE_URL=https://demo.lnbits.com
LNBITS_ADMIN_KEY=
LNBITS_INVOICE_KEY=


